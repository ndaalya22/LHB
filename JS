  // --- FUNGSI GLOBAL TOGGLE TINJAUAN A4 ---
  function toggleTinjauan(idTinjauan, btnEl) {
    const el = document.getElementById(idTinjauan);
    if (!el) return;

    const isHidden = el.classList.contains('hidden');
    if (isHidden) {
      el.classList.remove('hidden');
      if (btnEl) btnEl.innerHTML = '<i class="fas fa-eye-slash"></i> Sembunyikan Tinjauan';
    } else {
      el.classList.add('hidden');
      if (btnEl) btnEl.innerHTML = '<i class="fas fa-eye"></i> Buka Tinjauan A4';
    }
  }

  // --- SEMBUNYIKAN SEMUA TINJAUAN SAAT PERGANTIAN HALAMAN/FORM ---
  function sembunyikanSemuaTinjauan() {
    const daftarTinjauan = ['preview-area-siswa', 'preview-area-rapor', 'preview-kwitansi', 'preview-slip'];
    daftarTinjauan.forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    });
  }

  // --- FUNGSI GANTI JENIS SURAT (Menampilkan Form & Template yang Tepat) ---
  function gantiJenisSurat() {
    const jenis = document.getElementById('skJenis').value;
    
    // Reset Tampilan Kertas (Sembunyikan Semua)
    document.getElementById('tpl-aktif').style.display = 'none';
    document.getElementById('tpl-terima').style.display = 'none';
    document.getElementById('tpl-pindah').style.display = 'none';
    
    // Reset Tampilan Kolom Input Tambahan di Form
    document.getElementById('formGrupTtl').classList.remove('hidden');
    document.getElementById('formGrupJkKelas').classList.remove('hidden');
    document.getElementById('formGrupTahun').classList.remove('hidden');
    document.getElementById('formGrupAsal').classList.add('hidden');
    document.getElementById('formGrupPindah').classList.add('hidden');

    // Sesuaikan Berdasarkan Pilihan
    if (jenis === 'aktif') {
      document.getElementById('tpl-aktif').style.display = 'block';
      document.getElementById('skTempat').value = 'Rawamerta';
      document.getElementById('skTanggal').value = '7 September 2026';
    } 
    else if (jenis === 'terima') {
      document.getElementById('tpl-terima').style.display = 'block';
      document.getElementById('formGrupJkKelas').classList.add('hidden'); // Sembunyikan JK, Kelas tetap dipakai di teks
      document.getElementById('skKelas').parentElement.parentElement.classList.remove('hidden'); // Paksa tampilkan kelas saja jika perlu, tapi kita akali lewat css
      
      // Khusus Terima Siswa
      document.getElementById('formGrupAsal').classList.remove('hidden');
      document.getElementById('skTempat').value = 'Karawang';
      document.getElementById('skTanggal').value = '5 Oktober 2026';
    } 
    else if (jenis === 'pindah') {
      document.getElementById('tpl-pindah').style.display = 'block';
      document.getElementById('formGrupTtl').classList.add('hidden');
      document.getElementById('formGrupTahun').classList.add('hidden');
      document.getElementById('formGrupPindah').classList.remove('hidden');
      document.getElementById('skTempat').value = 'Rawamerta';
      document.getElementById('skTanggal').value = '2 Juli 2026';
    }
    
    // Eksekusi update teks setelah mengganti template
    updateSuratKeluar();
  }

  // --- FUNGSI LIVE PREVIEW: SURAT KELUAR ---
  function updateSuratKeluar() {
    const fields = [
      'skNomor', 'skNama', 'skNis', 'skNisn', 'skTtl', 'skJk', 
      'skKelas', 'skTahun', 'skAsal', 'skAyah', 'skIbu', 'skAlasan',
      'skTempat', 'skTanggal'
    ];
    
    // Update semua teks biasa yang memiliki class v-[id-input]
    fields.forEach(id => {
      const val = document.getElementById(id).value;
      const elements = document.querySelectorAll('.v-' + id);
      elements.forEach(el => {
        el.innerText = val;
      });
    });

    // Khusus Textarea (Sekolah Tujuan)
    const tujuanVal = document.getElementById('skTujuan').value;
    document.querySelectorAll('.v-skTujuan').forEach(el => {
      el.innerHTML = tujuanVal ? tujuanVal.replace(/\n/g, ' ') : '';
    });
  }

  // 4. FUNGSI LIVE PREVIEW: PEMBIAYAAN
  function updatePembiayaan() {
    // Format ke Rupiah
    const formatRp = (angka) => new Intl.NumberFormat('id-ID').format(angka || 0);

    // 1. Data Teks Biasa
    const textFields = ['byNamaSiswa', 'byKelas', 'byTerbilangSiswa', 'byNamaGuru', 'byBulanJabatan', 'byTanggal', 'byPetugas'];
    textFields.forEach(id => {
      const val = document.getElementById(id).value;
      document.querySelectorAll('.v-' + id).forEach(el => el.innerText = val || '');
    });

    // 2. Kalkulasi Siswa (Kwitansi) & Sembunyikan jika 0
    const spp = parseInt(document.getElementById('bySpp').value) || 0;
    const seragam = parseInt(document.getElementById('bySeragam').value) || 0;
    const tahunan = parseInt(document.getElementById('byTahunan').value) || 0;
    const ekskul = parseInt(document.getElementById('byEkskul').value) || 0;
    const bangunan = parseInt(document.getElementById('byBangunan').value) || 0;
    
    document.querySelectorAll('.v-bySpp').forEach(el => el.innerText = formatRp(spp));
    document.querySelectorAll('.v-bySeragam').forEach(el => el.innerText = formatRp(seragam));
    document.querySelectorAll('.v-byTahunan').forEach(el => el.innerText = formatRp(tahunan));
    document.querySelectorAll('.v-byEkskul').forEach(el => el.innerText = formatRp(ekskul));
    document.querySelectorAll('.v-byBangunan').forEach(el => el.innerText = formatRp(bangunan));
    
    // Logika Menampilkan/Menyembunyikan List
    const liSpp = document.getElementById('liBySpp'); if(liSpp) liSpp.style.display = spp > 0 ? 'list-item' : 'none';
    const liSeragam = document.getElementById('liBySeragam'); if(liSeragam) liSeragam.style.display = seragam > 0 ? 'list-item' : 'none';
    const liTahunan = document.getElementById('liByTahunan'); if(liTahunan) liTahunan.style.display = tahunan > 0 ? 'list-item' : 'none';
    const liEkskul = document.getElementById('liByEkskul'); if(liEkskul) liEkskul.style.display = ekskul > 0 ? 'list-item' : 'none';
    const liBangunan = document.getElementById('liByBangunan'); if(liBangunan) liBangunan.style.display = bangunan > 0 ? 'list-item' : 'none';

    const totalSiswa = spp + seragam + tahunan + ekskul + bangunan;
    const elTotalSiswa = document.getElementById('prevByTotalSiswa');
    if(elTotalSiswa) elTotalSiswa.innerText = formatRp(totalSiswa);

    // 3. Kalkulasi Guru (Slip Gaji)
    const gapok = parseInt(document.getElementById('byGapok').value) || 0;
    const transport = parseInt(document.getElementById('byTransport').value) || 0;
    const kegiatan = parseInt(document.getElementById('byKegiatan').value) || 0;
    const potongan = parseInt(document.getElementById('byPotongan').value) || 0;

    document.querySelectorAll('.v-byGapok').forEach(el => el.innerText = formatRp(gapok));
    document.querySelectorAll('.v-byTransport').forEach(el => el.innerText = formatRp(transport));
    document.querySelectorAll('.v-byKegiatan').forEach(el => el.innerText = formatRp(kegiatan));
    document.querySelectorAll('.v-byPotongan').forEach(el => el.innerText = formatRp(potongan));

    const totalPenerimaan = gapok + transport + kegiatan;
    const gajiBersih = totalPenerimaan - potongan;

    const elSubPenerimaan = document.getElementById('prevBySubPenerimaan');
    if(elSubPenerimaan) elSubPenerimaan.innerText = formatRp(totalPenerimaan);
    
    const elSubPotongan = document.getElementById('prevBySubPotongan');
    if(elSubPotongan) elSubPotongan.innerText = formatRp(potongan);
    
    const elTotalGuru = document.getElementById('prevByTotalGuru');
    if(elTotalGuru) elTotalGuru.innerText = formatRp(gajiBersih);
  }

  // 5. FUNGSI LIVE PREVIEW: RAPOR
  function updateRapor() {
    const textFields = [
      'Nama', 'Nis', 'Kelas', 'Tahun',
      'ValPai', 'ValPp', 'ValBindo', 'ValMtk', 'ValIpas', 'ValPjok', 'ValSeni', 'ValBing', 'ValMulok',
      'EkskulNama', 'EkskulPredikat', 'EkskulKet',
      'Sakit', 'Izin', 'Alpa', 'Tanggal'
    ];
    
    textFields.forEach(f => {
      const el = document.getElementById('rp' + f);
      const prevEl = document.getElementById('prevRp' + f);
      if(el && prevEl) {
        prevEl.innerText = el.value || (f === 'Sakit' || f === 'Izin' || f === 'Alpa' ? '0' : '');
      }
    });

    const textareas = ['DescPai', 'DescPp', 'DescBindo', 'DescMtk', 'DescIpas', 'DescPjok', 'DescSeni', 'DescBing', 'DescMulok', 'Catatan'];
    textareas.forEach(f => {
      const el = document.getElementById('rp' + f);
      const prevEl = document.getElementById('prevRp' + f);
      if(el && prevEl) {
        prevEl.innerHTML = el.value ? el.value.replace(/\n/g, '<br>') : '';
      }
    });

    const semester = document.getElementById('rpSemester').value;
    document.getElementById('prevRpSemester').innerText = semester;
    
    const formKenaikan = document.getElementById('formKenaikanContainer');
    const prevKenaikan = document.getElementById('prevKenaikanContainer');
    const kenaikanVal = document.getElementById('rpKenaikan');
    
    if(semester === '2') {
        formKenaikan.classList.remove('hidden');
        prevKenaikan.style.display = 'block';
        document.getElementById('prevRpKenaikan').innerText = kenaikanVal.value;
    } else {
        formKenaikan.classList.add('hidden');
        prevKenaikan.style.display = 'none';
        kenaikanVal.value = '';
    }

    document.getElementById('prevRpWali').innerText = document.getElementById('rpWali').value || '___________________';
    document.getElementById('prevRpKepsek').innerText = document.getElementById('rpKepsek').value || '___________________';
  }

