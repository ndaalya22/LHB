  // --- FUNGSI CRUD DATA SISWA BARU ---
  let globalSiswaData = []; // Variabel untuk menyimpan data agar mudah diedit

  function muatDataSiswa() {
    const tbody = document.querySelector('#tabel-siswa tbody');
    if(tbody) {
        tbody.innerHTML = '<tr><td colspan="4" class="p-4 text-center">Memuat data dari database...</td></tr>';
        google.script.run.withSuccessHandler(tampilkanTabelSiswa).getSemuaSiswa();
    }
  }

  function tampilkanTabelSiswa(data) {
    globalSiswaData = data; // Kunci agar tombol ubah bisa membaca data
    
    // Elemen Tabel di Halaman Biodata Siswa
    const tbodyAktif = document.querySelector('#tabel-siswa tbody');
    const tbodyLulusan = document.querySelector('#tabel-siswa-lulusan-bio tbody');
    
    // Elemen Tabel di Halaman Master Data Induk
    const tbodyMasterAktif = document.querySelector('#tabel-master-aktif tbody');
    const tbodyMasterLulusan = document.querySelector('#tabel-master-lulusan tbody');
    
    // Kosongkan semua tabel sebelum diisi ulang
    if(tbodyAktif) tbodyAktif.innerHTML = '';
    if(tbodyLulusan) tbodyLulusan.innerHTML = '';
    if(tbodyMasterAktif) tbodyMasterAktif.innerHTML = '';
    if(tbodyMasterLulusan) tbodyMasterLulusan.innerHTML = '';
    
    // Pisahkan data secara otomatis berdasarkan status Dropdown yang tersimpan di Drive
    const aktif = data.filter(s => s.status !== "Lulusan");
    const lulusan = data.filter(s => s.status === "Lulusan");
    
    // 1. RENDER SISWA AKTIF (Ke Biodata & Master Induk)
    if (aktif.length === 0) {
      if(tbodyAktif) tbodyAktif.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Belum ada siswa aktif</td></tr>';
      if(tbodyMasterAktif) tbodyMasterAktif.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-gray-500">Belum ada siswa aktif</td></tr>';
    } else {
      aktif.forEach(s => {
        // Tabel Biodata
        if(tbodyAktif) tbodyAktif.innerHTML += `
          <tr>
            <td class="p-2 border font-semibold">${s.nama}</td>
            <td class="p-2 border">${s.nisn}</td>
            <td class="p-2 border">${s.kelas}</td>
            <td class="p-2 border whitespace-nowrap">
              <button onclick="editSiswa(${s.baris})" class="bg-yellow-500 text-white px-2 py-1 rounded text-xs shadow">Ubah</button>
              <button onclick="hapusSiswa(${s.baris})" class="bg-red-600 text-white px-2 py-1 rounded text-xs ml-1 shadow">Hapus</button>
            </td>
          </tr>
        `;
        // Tabel Master Induk
        if(tbodyMasterAktif) tbodyMasterAktif.innerHTML += `
          <tr>
            <td class="p-1 border">${s.nama}</td>
            <td class="p-1 border">${s.nisn}</td>
            <td class="p-1 border">${s.kelas}</td>
          </tr>
        `;
      });
    }
    
    // 2. RENDER SISWA LULUSAN (Ke Biodata & Master Induk)
    if (lulusan.length === 0) {
      if(tbodyLulusan) tbodyLulusan.innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Belum ada siswa lulusan</td></tr>';
      if(tbodyMasterLulusan) tbodyMasterLulusan.innerHTML = '<tr><td colspan="3" class="p-4 text-center text-gray-500">Belum ada siswa lulusan</td></tr>';
    } else {
      lulusan.forEach(s => {
        // Tabel Biodata Lulusan
        if(tbodyLulusan) tbodyLulusan.innerHTML += `
          <tr class="bg-green-50">
            <td class="p-2 border font-semibold text-green-800">${s.nama}</td>
            <td class="p-2 border">${s.nisn}</td>
            <td class="p-2 border font-bold text-center">${s.tahun}</td>
            <td class="p-2 border whitespace-nowrap">
              <button onclick="editSiswa(${s.baris})" class="bg-yellow-500 text-white px-2 py-1 rounded text-xs shadow">Ubah (Lihat)</button>
              <button onclick="hapusSiswa(${s.baris})" class="bg-red-600 text-white px-2 py-1 rounded text-xs ml-1 shadow">Hapus</button>
            </td>
          </tr>
        `;
        // Tabel Master Induk Lulusan
        if(tbodyMasterLulusan) tbodyMasterLulusan.innerHTML += `
          <tr>
            <td class="p-1 border">${s.nama}</td>
            <td class="p-1 border">${s.nisn}</td>
            <td class="p-1 border text-center font-bold">${s.tahun}</td>
          </tr>
        `;
      });
    }
    
    // 3. UPDATE DROPDOWN (Hanya tampilkan Siswa Aktif)
    // Dropdown Pembiayaan
    const selectBySiswa = document.getElementById('byNamaSiswa');
    if(selectBySiswa) {
        selectBySiswa.innerHTML = '<option value="">-- Pilih Siswa Aktif --</option>';
        aktif.forEach(s => { selectBySiswa.innerHTML += `<option value="${s.nama}">${s.nama} - ${s.kelas}</option>`; });
    }
    // Dropdown Mutasi Keluar
    const mutSelect = document.getElementById('mutPilihSiswa');
    if(mutSelect) {
        mutSelect.innerHTML = '<option value="">-- Pilih Siswa Aktif --</option>';
        aktif.forEach(s => { mutSelect.innerHTML += `<option value="${s.baris}">${s.nama} - ${s.kelas}</option>`; });
    }
  }

  

  // --- 2. PERBAIKAN SIMPAN SISWA (Membersihkan & Memunculkan Menu Utama) ---
  function simpanSiswa() {
    const data = {
      baris: document.getElementById('dsBaris').value,
      nama: document.getElementById('dsNama').value,
      nis: document.getElementById('dsNis').value,
      nisn: document.getElementById('dsNisn').value,
      ttl: document.getElementById('dsTtl').value,
      kelas: document.getElementById('dsKelas').value,
      tglMasuk: document.getElementById('dsTglMasuk').value,
      tahun: document.getElementById('dsTahun').value,
      nik: document.getElementById('dsNik').value,
      kk: document.getElementById('dsKk').value,
      ayah: document.getElementById('dsAyah').value,
      ibu: document.getElementById('dsIbu').value,
      alamat: document.getElementById('dsAlamat').value,
      status: document.getElementById('dsStatus').value
    };
    
    if(!data.nama || !data.nisn) return alert("Nama Lengkap dan NISN wajib diisi!");
    
    if (data.status === "Lulusan") {
       const payload = {
          baris: "", 
          info1: data.nama,
          info2: data.nisn,
          info3: data.tahun,
          json: JSON.stringify({ biodataLama: JSON.stringify(data) })
       };
       
       document.body.style.cursor = 'wait';
       google.script.run.withSuccessHandler(() => {
          if(data.baris) {
             google.script.run.withSuccessHandler(() => {
                document.body.style.cursor = 'default';
                alert("Siswa berhasil dipindah dan disimpan di Arsip Lulusan!");
                
                resetFormSiswa(); // Membersihkan form dan draf lokal
                muatDataSiswa(); 
                if(typeof muatDataLulusan === 'function') muatDataLulusan();
                
                tampilkanTombolMenuUtama();
             }).hapusDataSiswa(data.baris);
          } else {
             document.body.style.cursor = 'default';
             alert("Siswa berhasil disimpan di Arsip Lulusan!");
             
             resetFormSiswa(); // Membersihkan form dan draf lokal
             if(typeof muatDataLulusan === 'function') muatDataLulusan();
             
            tampilkanTombolMenuUtama();
          }
       }).prosesCrudUniversal('Data_Lulusan', 'save', payload);
       
    } else {
       google.script.run.withSuccessHandler((msg) => {
          alert(msg);
          
          resetFormSiswa(); // Membersihkan form dan draf lokal secara total
          muatDataSiswa();
          if(typeof muatDataLulusan === 'function') muatDataLulusan();
          
          tampilkanSidebarKembali(); // Munculkan menu utama
       }).simpanDataSiswa(data);
    }
  }

  // --- FUNGSI BANTUAN UNTUK MEMASTIKAN TOMBOL MENU UTAMA MUNCUL ---
  function bukaMenuUtama() {
      // Mencari elemen sidebar atau tombol menu utama berdasarkan ID atau kelas umum
      const sidebar = document.getElementById('sidebar');
      if(sidebar) {
          sidebar.classList.remove('hidden');
          sidebar.style.display = 'block';
      }
      
      // Jika aplikasi Anda menggunakan fungsi toggle/show menu utama, panggil di sini
      const tombolMenu = document.getElementById('tombolMenuUtama');
      if(tombolMenu) {
          tombolMenu.style.display = 'block';
      }
  }

  function editSiswa(baris) {
    // Memperbaiki pembacaan data agar tombol Ubah 100% berfungsi
    const s = globalSiswaData.find(x => parseInt(x.baris) === parseInt(baris));
    if(!s) { alert("Data gagal dimuat. Silakan klik Refresh Data."); return; }
    
    document.getElementById('formSiswaTitle').innerText = "Ubah Biodata Siswa";
    document.getElementById('dsBaris').value = s.baris;
    document.getElementById('dsNama').value = s.nama;
    document.getElementById('dsNis').value = s.nis;
    document.getElementById('dsNisn').value = s.nisn;
    document.getElementById('dsTtl').value = s.ttl;
    document.getElementById('dsKelas').value = s.kelas;
    document.getElementById('dsTglMasuk').value = s.tglMasuk;
    document.getElementById('dsTahun').value = s.tahun;
    document.getElementById('dsNik').value = s.nik;
    document.getElementById('dsKk').value = s.kk;
