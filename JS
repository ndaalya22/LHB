        // Kosongkan baris agar tidak tidak sengaja tersimpan ulang ke data aktif
        document.getElementById('dsBaris').value = ""; 
        
        document.getElementById('dsNama').value = s.nama || d.info1;
        document.getElementById('dsNis').value = s.nis || "";
        document.getElementById('dsNisn').value = s.nisn || d.info2;
        document.getElementById('dsTtl').value = s.ttl || "";
        document.getElementById('dsKelas').value = "LULUS (" + (d.info3||'') + ")";
        document.getElementById('dsTglMasuk').value = s.tglMasuk || "";
        document.getElementById('dsTahun').value = s.tahun || "";
        document.getElementById('dsNik').value = s.nik || "";
        document.getElementById('dsKk').value = s.kk || "";
        document.getElementById('dsAyah').value = s.ayah || "";
        document.getElementById('dsIbu').value = s.ibu || "";
        document.getElementById('dsAlamat').value = s.alamat || "";
        
        // Update kertas pratinjau A4
        updatePreviewSiswa();
