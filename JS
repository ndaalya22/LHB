const GAS_URL = "https://script.google.com/macros/s/AKfycbyIQsJaPYjSuxYT4XEaUw07YO8vea8tU2ElokvoM_r-wGWmuWPxGDmftaZZxTfbIq8G9Q/exec";

// Contoh MENGAMBIL Data (GET)
document.getElementById('btn-load').addEventListener('click', () => {
