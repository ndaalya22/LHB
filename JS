  // KALKULASI DAN SINKRONISASI KE PREVIEW A4
  function updateDaftar1() {
    const bulan = document.getElementById('d1Bulan').value;
    const tahun = document.getElementById('d1Tahun').value;
    const prevBulanTahun = document.getElementById('prevD1BulanTahun');
    if (prevBulanTahun) prevBulanTahun.innerText = `${bulan} ${tahun}`;

    // 1. Hitung Banyak Murid L & P Per Kelas
    let totL = 0, totP = 0;
    const kData = {};

    for (let i = 1; i <= 6; i++) {
      const l = parseInt(document.getElementById(`d1_k${i}_l`)?.value || 0);
      const p = parseInt(document.getElementById(`d1_k${i}_p`)?.value || 0);
      const sum = l + p;
      
      totL += l;
      totP += p;
      kData[i] = { l, p, sum };

      // Set Preview Murid per Kelas
      const elL = document.getElementById(`p_k${i}_l`);
      const elP = document.getElementById(`p_k${i}_p`);
      const elTot = document.getElementById(`p_k${i}_tot`);
      if (elL) elL.innerText = l;
      if (elP) elP.innerText = p;
      if (elTot) elTot.innerText = sum;
    }

    const grandTotal = totL + totP;
    
    // Set Total di Form Input
    const calcL = document.getElementById('calc_total_l');
    const calcP = document.getElementById('calc_total_p');
    if (calcL) calcL.innerText = totL;
    if (calcP) calcP.innerText = totP;

    // Set Total di Preview A4
    const pTotL = document.getElementById('p_tot_l');
    const pTotP = document.getElementById('p_tot_p');
    const pTotAll = document.getElementById('p_tot_all');
    const pTotLEnd = document.getElementById('p_tot_l_end');
    const pTotPEnd = document.getElementById('p_tot_p_end');
    const pTotGrand = document.getElementById('p_tot_grand');

    if (pTotL) pTotL.innerText = totL;
    if (pTotP) pTotP.innerText = totP;
    if (pTotAll) pTotAll.innerText = grandTotal;
    if (pTotLEnd) pTotLEnd.innerText = totL;
    if (pTotPEnd) pTotPEnd.innerText = totP;
    if (pTotGrand) pTotGrand.innerText = grandTotal;

    // 2. Hitung Matriks Usia Anak
    const prevTbodyUsia = document.getElementById('prevD1TbodyUsia');
    if (prevTbodyUsia) {
      prevTbodyUsia.innerHTML = '';
      
      dataUsiaDefault.forEach((item, idx) => {
        let rowSumL = 0, rowSumP = 0;
        let cellsHtml = '';

        ['u6','u7','u8','u9','u10','u11','u12','u13','u14'].forEach(u => {
          const val = document.getElementById(`u_${idx}_${u}`)?.value || '/';
          cellsHtml += `<td>${val}</td>`;

          if (val.includes('/')) {
            const parts = val.split('/');
            const lVal = parseInt(parts[0]) || 0;
            const pVal = parseInt(parts[1]) || 0;
            rowSumL += lVal;
            rowSumP += pVal;
          }
        });

        const rowTotal = rowSumL + rowSumP;
        const displayTotal = rowTotal > 0 ? `${rowSumL}/${rowSumP} = ${rowTotal}` : '-';

        // Update di Form Input
        const resEl = document.getElementById(`res_usia_${idx}`);
        if (resEl) resEl.innerText = displayTotal;

        // Render ke Preview A4
        prevTbodyUsia.innerHTML += `
          <tr>
            <td style="font-weight:bold; text-align:left;">${item.kelas}</td>
            ${cellsHtml}
            <td style="font-weight:bold; background-color:#f9fafb;">${displayTotal}</td>
          </tr>
        `;
      });
    }
  }

