  // --- FUNGSI LIVE PREVIEW: RINCIAN BIAYA (ANTI ERROR) ---
  function updateRincianBiaya() {
    try {
      const formatRp = (angka) => new Intl.NumberFormat('id-ID').format(angka || 0);
      let total = 0;

      // 1. Teks Biasa
      const textFields = ['rbNama', 'rbKelas', 'rbTanggal', 'rbKepsek'];
      textFields.forEach(id => {
        const input = document.getElementById(id);
        const val = input ? input.value : '';
        document.querySelectorAll('.v-' + id).forEach(el => el.innerText = val || '...');
      });

      // 2. Komponen Tetap (SPP dll)
      const numberFields = ['rbSpp', 'rbSeragam', 'rbBuku', 'rbKegiatan', 'rbLain'];
      numberFields.forEach(id => {
        const input = document.getElementById(id);
        const val = input ? parseInt(input.value) || 0 : 0;
        total += val;
        
        document.querySelectorAll('.v-' + id).forEach(el => el.innerText = formatRp(val));
        const tr = document.getElementById('tr' + id.charAt(0).toUpperCase() + id.slice(1));
        if (tr) tr.style.display = val > 0 ? 'table-row' : 'none';
      });

      // 3. Komponen Tambahan/Dinamis (3 buah)
      for (let i = 1; i <= 3; i++) {
        const nameInput = document.getElementById('rbTamNama' + i);
        const valInput = document.getElementById('rbTamVal' + i);
        
        const nama = nameInput ? nameInput.value : '';
        const val = valInput ? parseInt(valInput.value) || 0 : 0;
        total += val;

        // Tampilkan teks nama di kertas
        const labelKertas = document.getElementById('prevRbTamNama' + i);
        if (labelKertas) labelKertas.innerText = nama || `Biaya Lain-lain ${i}`;
        
        // Tampilkan nominal
        document.querySelectorAll('.v-rbTamVal' + i).forEach(el => el.innerText = formatRp(val));

        // Munculkan di baris kertas jika terisi nominal atau diketik namanya
        const trKertas = document.getElementById('trRbTam' + i);
        if (trKertas) {
