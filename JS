  function muatRiwayatAbsensi() {
    let riwayatLokal = JSON.parse(localStorage.getItem('db_absensi') || '[]');
    if (riwayatLokal.length > 0) renderTabelAbsensiLokal(riwayatLokal);
    else document.querySelector('#tabel-absensi tbody').innerHTML = '<tr><td colspan="4" class="p-4 text-center text-gray-500">Memuat dari server...</td></tr>';

    if (typeof google !== 'undefined' && google.script) {
      google.script.run.withSuccessHandler((data) => {
        if(data && Array.isArray(data)) {
          localStorage.setItem('db_absensi', JSON.stringify(data)); 
          renderTabelAbsensiLokal(data);
        }
      }).getRiwayatAbsensi();
    }
  }

  function bunyiBeepSukes() {
    try {
      const ctx = new (window.AudioContext || window.webkitAudioContext)();
      const osc = ctx.createOscillator();
      osc.connect(ctx.destination);
      osc.frequency.value = 850;
      osc.start();
      osc.stop(ctx.currentTime + 0.1);
    } catch(e) {}
  }
