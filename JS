  function simpanDrafKeBrowser(idInput) {
    const elemen = document.getElementById(idInput);
    if(elemen) {
      localStorage.setItem('draf_' + idInput, elemen.value);
    }
  }

  // Fungsi ini memuat ulang tulisan yang tersimpan saat web dibuka
  function muatDrafDariBrowser() {
    // Cari semua elemen input dan textarea di halaman
    const inputs = document.querySelectorAll('input, textarea');
    inputs.forEach(input => {
      const savedValue = localStorage.getItem('draf_' + input.id);
      if(savedValue !== null) {
        input.value = savedValue;
      }
      
      // Tambahkan event pendeteksi ketikan agar otomatis tersimpan ke browser
      input.addEventListener('input', function() {
        simpanDrafKeBrowser(this.id);
      });
    });
  }

