  // 2. FUNGSI LIVE PREVIEW: BIODATA SISWA
  function updateLivePreview() {
    const nama = document.getElementById('inpSiswaNama').value;
    const nis = document.getElementById('inpSiswaNis').value;
    const kelas = document.getElementById('inpSiswaKelas').value;

    document.getElementById('prevSiswaNama').innerText = nama || '-';
