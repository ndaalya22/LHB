    let res = [];
    
    // Ambil 50 data terbaru dari bawah ke atas
    for (let i = data.length - 1; i > 0; i--) { 
      res.push({
        id: data[i][0], nama: data[i][1], peran: data[i][2], tanggal: data[i][3], jam: data[i][4]
