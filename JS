  // 6. Fungsi Edit & Switch
  function editTranskrip(baris) {
    const d = dbTranskrip.find(x => x.baris === baris);
    if (!d) return;
    const detail = JSON.parse(d.json || '{}');
    
    document.getElementById('trBaris').value = d.baris;
    
    // Sinkron dropdown
    const cariLulusan = (typeof dbLulusan !== 'undefined' ? dbLulusan : []).find(l => l.info2 === d.info2);
    if (cariLulusan) { document.getElementById('trPilihSiswa').value = cariLulusan.baris; sinkronLulusanKeTranskrip(); }

    document.getElementById('trTglLulus').value = detail.tglLulus || '';
    document.getElementById('trTglTerbit').value = detail.tglTerbit || '';
    document.getElementById('trKepsek').value = detail.kepsek || '';
    
    ['Pai','Pp','Bindo','Mtk','Ipas','Pjok','Seni','Bing','Mulok'].forEach(f => {
      document.getElementById('trVal' + f).value = detail[f.toLowerCase()] || '';
    });
    
    updateTranskrip();
  }

