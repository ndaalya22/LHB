  // LOGIKA TRANSKRIP & IJAZAH (SINKRON DATA LULUSAN & DRIVE)
  // ==========================================
  let dbTranskrip = [];

  // 1. Muat Data Transkrip & Siapkan Dropdown Lulusan
  function muatDataTranskrip() {
    const select = document.getElementById('trPilihSiswa');
    if (select) {
       select.innerHTML = '<option value="">-- Pilih Siswa Lulusan --</option>';
       
       // Cek apakah dbLulusan ada dan berisi data
       if (typeof dbLulusan !== 'undefined' && dbLulusan.length > 0) {
          dbLulusan.forEach(d => {
             select.innerHTML += `<option value="${d.baris}">${d.info1} (NISN: ${d.info2})</option>`;
          });
       } else {
          // Jika kosong, muat ulang dari Drive Data_Lulusan
          google.script.run.withSuccessHandler(data => {
            if(typeof dbLulusan !== 'undefined') dbLulusan = data;
            data.forEach(d => { select.innerHTML += `<option value="${d.baris}">${d.info1} (NISN: ${d.info2})</option>`; });
          }).prosesCrudUniversal('Data_Lulusan', 'read', {});
       }
    }

    google.script.run.withSuccessHandler(data => {
      dbTranskrip = data;
      renderTabelTranskrip();
    }).prosesCrudUniversal('Data_Transkrip', 'read', {});
  }

  // 2. Tarik Data Otomatis Saat Dropdown Dipilih
  function sinkronLulusanKeTranskrip() {
    const baris = document.getElementById('trPilihSiswa').value;
    if (!baris) { resetFormTranskrip(); return; }

    const d = (typeof dbLulusan !== 'undefined' ? dbLulusan : []).find(x => x.baris.toString() === baris);
    if (d) {
       const detail = JSON.parse(d.json || '{}');
       const bioLama = detail.biodataLama ? JSON.parse(detail.biodataLama) : {};
       
       document.getElementById('trNama').value = d.info1;
       document.getElementById('trNisn').value = d.info2;
       document.getElementById('trTahun').value = d.info3;
       document.getElementById('trNoIjazah').value = detail.noIjazah || '';
       document.getElementById('trTtl').value = bioLama.ttl || '';
    }
  }

  // 3. Live Preview Tinjauan Kertas
  function updateTranskrip() {
    try {
      const textFields = ['trNama', 'trNisn', 'trNoIjazah', 'trTtl', 'trTglLulus', 'trTglTerbit', 'trTahun', 'trKepsek'];
      textFields.forEach(id => {
        const el = document.getElementById(id);
        if(el) { document.querySelectorAll('.v-' + id).forEach(v => v.innerText = el.value || '-'); }
      });

      const nilaiFields = ['Pai', 'Pp', 'Bindo', 'Mtk', 'Ipas', 'Pjok', 'Seni', 'Bing', 'Mulok'];
      nilaiFields.forEach(f => {
        const el = document.getElementById('trVal' + f);
        const prevEl = document.getElementById('prevTrVal' + f);
        if(el && prevEl) { prevEl.innerText = el.value ? parseFloat(el.value).toFixed(2) : '-'; }
      });
    } catch (e) { console.error("Error Preview: " + e.message); }
  }

  // 4. Simpan Transkrip ke Google Drive
  function simpanTranskrip() {
    const barisDropdown = document.getElementById('trPilihSiswa').value;
    const nama = document.getElementById('trNama').value;
    const nisn = document.getElementById('trNisn').value;
    const tahun = document.getElementById('trTahun').value;

    if (!barisDropdown || !nama) return alert("Pilih Siswa Lulusan terlebih dahulu!");

    const jsonDetail = {
      noIjazah: document.getElementById('trNoIjazah').value,
      tglLulus: document.getElementById('trTglLulus').value,
      tglTerbit: document.getElementById('trTglTerbit').value,
      kepsek: document.getElementById('trKepsek').value,
      pai: document.getElementById('trValPai').value,
      pp: document.getElementById('trValPp').value,
      bindo: document.getElementById('trValBindo').value,
      mtk: document.getElementById('trValMtk').value,
      ipas: document.getElementById('trValIpas').value,
      pjok: document.getElementById('trValPjok').value,
      seni: document.getElementById('trValSeni').value,
      bing: document.getElementById('trValBing').value,
      mulok: document.getElementById('trValMulok').value
    };

    const payload = {
      baris: document.getElementById('trBaris').value,
      info1: nama, info2: nisn, info3: tahun,
      json: JSON.stringify(jsonDetail)
    };

    document.body.style.cursor = 'wait';
    google.script.run
      .withSuccessHandler(() => {
        document.body.style.cursor = 'default';
        alert("Transkrip Nilai berhasil disimpan permanen ke Google Drive!");
        muatDataTranskrip();
      })
      .prosesCrudUniversal('Data_Transkrip', 'save', payload);
  }

