  // --- FUNGSI UPDATE: PENUMPUKAN NILAI SAAT DISIMPAN ---
  function simpanPortofolio() {
    simpanInputSementara(); // Ambil angka yang sedang diketik
    
    const nama = document.getElementById('pfNama').value;
    const nisn = document.getElementById('pfNisn').value.trim();
    const thnMasuk = document.getElementById('pfTahunMasuk').value;
    
    if (!nama || !nisn) return alert("Nama dan NISN wajib diisi!");
    
    let baris = document.getElementById('pfBaris').value;

    // LOGIKA PENUMPUKAN OTOMATIS (AUTO-MERGE)
    // Jika Anda lupa menarik data lama, sistem akan mengamankannya dan menggabungkannya secara otomatis
    if (!baris) {
       const existing = dbPortofolio.find(x => x.info2.toLowerCase() === nisn.toLowerCase());
       if (existing) {
          baris = existing.baris;
          const oldData = JSON.parse(existing.json);
          
          // Sisipkan/Tumpuk nilai lama ke kolom yang kosong (yang belum diketik saat ini)
          for (let k = 1; k <= 6; k++) {
            if (!pfDataNilai[k]) pfDataNilai[k] = {};
            
            if (oldData.nilai && oldData.nilai[k]) {
              Object.keys(oldData.nilai[k]).forEach(key => {
                 // Jika form saat ini kosong, isi dengan jejak nilai lama agar tidak terhapus
                 if (!pfDataNilai[k][key] || pfDataNilai[k][key] === '') {
                     pfDataNilai[k][key] = oldData.nilai[k][key];
                 }
              });
            }
          }
       }
    }

    const payload = {
      baris: baris,
      info1: nama, info2: nisn, info3: pfDataNilai[1].tahun, // Simpan histori Tahun Masuk Kls 1
      json: JSON.stringify({ thnStart: thnMasuk, nilai: pfDataNilai })
    };

    google.script.run.withSuccessHandler(msg => {
      alert("Portofolio Berhasil Disimpan & Ditumpuk!"); 
      muatPortofolio();
      const statusEl = document.getElementById('statusPf');
      if (statusEl) statusEl.innerHTML = '<span class="text-green-600 font-bold">(Tersimpan)</span>';
    }).prosesCrudUniversal('Data_Portofolio', 'save', payload);
