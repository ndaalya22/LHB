// --- 1. FUNGSI PENCARI DATA SISWA & GURU OTOMATIS (ANTI-CRASH) ---
  function cariIdentitasOtomatis(keyword) {
    if (!keyword) return null;
    // Ubah keyword menjadi string dengan aman untuk mencegah error tipe data
    const kataKunci = String(keyword).toLowerCase().trim();
    
    // Cari di Data Siswa
    if (typeof globalSiswaData !== 'undefined' && Array.isArray(globalSiswaData)) {
      const siswa = globalSiswaData.find(s => {
        const nisn = s.nisn ? String(s.nisn).toLowerCase() : '';
        const nama = s.nama ? String(s.nama).toLowerCase() : '';
        return nisn === kataKunci || nama === kataKunci;
      });
      if (siswa) return { nama: siswa.nama, peran: 'Siswa' };
    }
    
    // Cari di Data Guru
    if (typeof dbGuru !== 'undefined' && Array.isArray(dbGuru)) {
      const guru = dbGuru.find(g => {
        const nama = g.info1 ? String(g.info1).toLowerCase() : '';
        return nama === kataKunci;
      });
      if (guru) return { nama: guru.info1, peran: 'Guru' };
    }
    
    return null; // Jika tidak ditemukan
  }

  // --- PROSES ABSENSI (CEK DATA AKUN & VALIDASI) ---
  function prosesAbsensiAlternatif() {
    try {
      const metode = document.getElementById('metodeAbsen').value;
      let nama = "";
      let peran = "";
      let inputData = "";

      if (metode === 'manual') {
        inputData = document.getElementById('absenNama').value;
        if (!inputData) return alert("Nama / NISN wajib diisi!");
        
        const cek = cariIdentitasOtomatis(inputData);
        if (cek) { nama = cek.nama; peran = cek.peran + " (Manual)"; } 
        else { nama = inputData; peran = document.getElementById('absenPeran').value + " (Manual)"; }
      } 
      
      // LOGIKA BARU UNTUK QR CODE
      else if (metode === 'qr') {
        inputData = document.getElementById('absenDataQR').value.trim();
        if (!inputData) return alert("Kode QR kosong! Arahkan kursor ke kolom lalu Scan.");
        
        // Cek apakah QR terdaftar di Data Akun
        const akun = dbAkun.find(a => JSON.parse(a.json).idUser.toLowerCase() === inputData.toLowerCase());
        if (akun) {
          nama = akun.info1; peran = akun.info2 + " (QR)";
        } else {
          // Jika tidak ada di Akun, coba cek di Data Siswa
          const cek = cariIdentitasOtomatis(inputData);
          if (cek) { nama = cek.nama; peran = cek.peran + " (QR)"; } 
          else { nama = inputData; peran = "Tamu (QR)"; }
        }
      } 
      
      // LOGIKA BARU UNTUK PIN PASSWORD
      else if (metode === 'pin') {
        const userId = document.getElementById('absenUserPin').value.trim();
        const pinInput = document.getElementById('absenKodePin').value;
        if (!userId || !pinInput) return alert("ID dan PIN wajib diisi!");
        
        // Wajib mencocokkan ID dan PIN dengan Data Akun yang sudah dibuat
        const akun = dbAkun.find(a => {
          const detail = JSON.parse(a.json);
          return detail.idUser.toLowerCase() === userId.toLowerCase() || a.info1.toLowerCase() === userId.toLowerCase();
        });

        if (akun) {
          if (akun.info3 !== pinInput) return alert("Gagal Absen: PIN Salah!");
          nama = akun.info1; 
          peran = akun.info2 + " (PIN)";
        } else {
          return alert("Gagal Absen: Akun ID tidak ditemukan. Silakan buat akun di menu Kelola Akun terlebih dahulu.");
        }
      } 
      
      else if (metode === 'jari') {
        inputData = prompt("Simulasi Biometrik: Tempelkan jari (Ketik NISN/Nama Anda)", "");
        if (!inputData) return;
        const cek = cariIdentitasOtomatis(inputData);
        if (cek) { nama = cek.nama; peran = cek.peran + " (Biometrik)"; } 
        else { return alert("Sidik jari tidak dikenali (Data tidak terdaftar)."); }
      }

      // Pastikan nama terisi sebelum menyimpan
      if (nama && peran) {
        simpanAbsenKeBrowserDanDrive(nama, peran);
      }
      
    } catch (error) {
      alert("Terjadi kesalahan sistem saat memproses form: " + error.message);
    }
  }

  // --- 3. SISTEM SIMPAN GANDA (BROWSER + DRIVE) ---
  function simpanAbsenKeBrowserDanDrive(nama, peran) {
    try {
      const btn = document.getElementById('btnProsesAbsen');
      const teksAsli = btn.innerText;
      btn.innerText = "Menyimpan Data...";
      btn.disabled = true;

      // Efek Kamera (Flash)
      const overlay = document.getElementById('scan-overlay');
      if (overlay) { 
        overlay.classList.remove('hidden'); 
        setTimeout(() => overlay.classList.add('hidden'), 200); 
      }

      // Format Waktu Universal agar tidak error di berbagai browser
      const now = new Date();
      const tglLokal = ("0" + now.getDate()).slice(-2) + "-" + ("0" + (now.getMonth() + 1)).slice(-2) + "-" + now.getFullYear();
      const jamLokal = ("0" + now.getHours()).slice(-2) + ":" + ("0" + now.getMinutes()).slice(-2) + ":" + ("0" + now.getSeconds()).slice(-2);
      
      // 1. Simpan Sementara di Browser (Instan)
      let riwayatLokal = JSON.parse(localStorage.getItem('db_absensi') || '[]');
      riwayatLokal.unshift({ nama: nama, peran: peran, tanggal: tglLokal, jam: jamLokal }); 
      if (riwayatLokal.length > 50) riwayatLokal.pop(); 
      localStorage.setItem('db_absensi', JSON.stringify(riwayatLokal));
      renderTabelAbsensiLokal(riwayatLokal);

      // 2. Simpan Ke Drive (Mencegah Aplikasi Mati Jika Internet Putus)
      if (typeof google !== 'undefined' && google.script && google.script.run) {
        google.script.run
          .withSuccessHandler((res) => {
            btn.innerText = teksAsli;
            btn.disabled = false;
            
            if (res && res.status === 'success') {
              bunyiBeepSukes();
              document.getElementById('absenNama').value = '';
              document.getElementById('absenDataQR').value = '';
              document.getElementById('absenUserPin').value = '';
              document.getElementById('absenKodePin').value = '';
              muatRiwayatAbsensi();
            } else {
              alert("Gagal menyimpan ke Drive. Data hanya tersimpan sementara di Browser.");
            }
          })
          .withFailureHandler((err) => {
            btn.innerText = teksAsli;
            btn.disabled = false;
            alert("Koneksi ke Google terputus. Data sementara aman di perangkat Anda.");
          })
          .simpanAbsensi(nama, peran);
      } else {
        // Mode Simulasi jika dijalankan tanpa server Apps Script
        setTimeout(() => {
          btn.innerText = teksAsli;
          btn.disabled = false;
          bunyiBeepSukes();
          alert("Mode Simulasi Berhasil! (Data disimpan secara lokal)");
        }, 1000);
      }
    } catch (error) {
      alert("Error saat mencoba menyimpan: " + error.message);
      const btn = document.getElementById('btnProsesAbsen');
      if(btn) { btn.innerText = "Proses Kehadiran"; btn.disabled = false; }
    }
  }

