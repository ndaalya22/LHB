  // --- FUNGSI KHUSUS SIMPAN LAPORAN DAFTAR 1 KE GOOGLE DRIVE ---
  function simpanDaftar1() {
    const bulan = document.getElementById('d1Bulan').value;
    const tahun = document.getElementById('d1Tahun').value;

    // 1. Ambil data jumlah murid per kelas (I - VI)
    const muridData = {};
    for (let i = 1; i <= 6; i++) {
      muridData[`k${i}_l`] = document.getElementById(`d1_k${i}_l`)?.value || "0";
      muridData[`k${i}_p`] = document.getElementById(`d1_k${i}_p`)?.value || "0";
    }

    // 2. Ambil data matriks usia (6 - 14 Tahun)
    const usiaData = [];
    const uKeys = ['u6','u7','u8','u9','u10','u11','u12','u13','u14'];
    for (let idx = 0; idx < 6; idx++) {
      const rowUsia = { kelas: `Kelas ${idx + 1}` };
      uKeys.forEach(u => {
        rowUsia[u] = document.getElementById(`u_${idx}_${u}`)?.value || "/";
      });
      usiaData.push(rowUsia);
    }

    const totalL = document.getElementById('calc_total_l')?.innerText || "0";
    const totalP = document.getElementById('calc_total_p')?.innerText || "0";
    const grandTotal = (parseInt(totalL) || 0) + (parseInt(totalP) || 0);

    // 3. Susun Paket Data (Payload)
    const payload = {
      baris: "", 
      info1: `${bulan} ${tahun}`, // Periode Laporan
      info2: `${grandTotal} Siswa (L:${totalL}, P:${totalP})`, // Rekap Total
      info3: tahun,
      json: JSON.stringify({
        bulan: bulan,
        tahun: tahun,
        murid: muridData,
        usia: usiaData,
        totalL: totalL,
        totalP: totalP,
        grandTotal: grandTotal
      })
    };

    // 4. Kirim Data ke Google Apps Script (Backend Sheet)
    document.body.style.cursor = 'wait';
    google.script.run
      .withSuccessHandler((res) => {
        document.body.style.cursor = 'default';
        alert(`Laporan Daftar 1 Bulanan (${bulan} ${tahun}) BERHASIL DISIMPAN ke Google Drive/Sheets!`);
      })
      .withFailureHandler((err) => {
        document.body.style.cursor = 'default';
        alert("Gagal menyimpan data ke Drive: " + err.message);
      })
      .prosesCrudUniversal('Data_Daftar1', 'save', payload);
  }
