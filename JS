  function updatePembiayaan() {
    // Format ke Rupiah
    const formatRp = (angka) => new Intl.NumberFormat('id-ID').format(angka || 0);

    // 1. Data Teks Biasa
    const textFields = ['byNamaSiswa', 'byKelas', 'byTerbilangSiswa', 'byNamaGuru', 'byBulanJabatan', 'byTanggal', 'byPetugas'];
    textFields.forEach(id => {
      const val = document.getElementById(id).value;
      document.querySelectorAll('.v-' + id).forEach(el => el.innerText = val || '');
    });

    // 2. Kalkulasi Siswa (Kwitansi) & Atur Tampil/Sembunyi Baris
    const spp = parseInt(document.getElementById('bySpp').value) || 0;
    const seragam = parseInt(document.getElementById('bySeragam').value) || 0;
    const tahunan = parseInt(document.getElementById('byTahunan').value) || 0;
    const ekskul = parseInt(document.getElementById('byEkskul').value) || 0;
    const bangunan = parseInt(document.getElementById('byBangunan').value) || 0;
    
    document.querySelectorAll('.v-bySpp').forEach(el => el.innerText = formatRp(spp));
    document.querySelectorAll('.v-bySeragam').forEach(el => el.innerText = formatRp(seragam));
    document.querySelectorAll('.v-byTahunan').forEach(el => el.innerText = formatRp(tahunan));
    document.querySelectorAll('.v-byEkskul').forEach(el => el.innerText = formatRp(ekskul));
    document.querySelectorAll('.v-byBangunan').forEach(el => el.innerText = formatRp(bangunan));
    
    // Perbaikan Logika Tampil / Sembunyi List Kwitansi
    const liSpp = document.getElementById('liBySpp'); 
    if(liSpp) liSpp.style.display = spp > 0 ? 'block' : 'none';

    const liSeragam = document.getElementById('liBySeragam'); 
    if(liSeragam) liSeragam.style.display = seragam > 0 ? 'block' : 'none';

    const liTahunan = document.getElementById('liByTahunan'); 
    if(liTahunan) liTahunan.style.display = tahunan > 0 ? 'block' : 'none';

    const liEkskul = document.getElementById('liByEkskul'); 
    if(liEkskul) liEkskul.style.display = ekskul > 0 ? 'block' : 'none';

    const liBangunan = document.getElementById('liByBangunan'); 
    if(liBangunan) liBangunan.style.display = bangunan > 0 ? 'block' : 'none';

    const totalSiswa = spp + seragam + tahunan + ekskul + bangunan;
    const elTotalSiswa = document.getElementById('prevByTotalSiswa');
    if(elTotalSiswa) elTotalSiswa.innerText = formatRp(totalSiswa);

    // 3. Kalkulasi Guru (Slip Gaji)
    const gapok = parseInt(document.getElementById('byGapok').value) || 0;
    const transport = parseInt(document.getElementById('byTransport').value) || 0;
    const kegiatan = parseInt(document.getElementById('byKegiatan').value) || 0;
    const potongan = parseInt(document.getElementById('byPotongan').value) || 0;

    document.querySelectorAll('.v-byGapok').forEach(el => el.innerText = formatRp(gapok));
    document.querySelectorAll('.v-byTransport').forEach(el => el.innerText = formatRp(transport));
    document.querySelectorAll('.v-byKegiatan').forEach(el => el.innerText = formatRp(kegiatan));
    document.querySelectorAll('.v-byPotongan').forEach(el => el.innerText = formatRp(potongan));

    const totalPenerimaan = gapok + transport + kegiatan;
    const gajiBersih = totalPenerimaan - potongan;

    const elSubPenerimaan = document.getElementById('prevBySubPenerimaan');
    if(elSubPenerimaan) elSubPenerimaan.innerText = formatRp(totalPenerimaan);
    
    const elSubPotongan = document.getElementById('prevBySubPotongan');
    if(elSubPotongan) elSubPotongan.innerText = formatRp(potongan);
    
    const elTotalGuru = document.getElementById('prevByTotalGuru');
    if(elTotalGuru) elTotalGuru.innerText = formatRp(gajiBersih);
  }
